{
  "name": "chinese-image-translator",
  "version": "1.0.3",
  "description": "AI-powered Chinese image translator with OCR and LLM - Chụp ảnh, dịch tiếng Trung sang tiếng Việt ngay lập tức",
  "author": "huyletrannhat27-prog",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",

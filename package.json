    "nextjs",
    "tesseract",
    "tesseract.js",
    "gemini"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/huyletrannhat27-prog/Chinese-Image-Translator-AI.git"
  },
  "bugs": {
    "url": "https://github.com/huyletrannhat27-prog/Chinese-Image-Translator-AI/issues"

# Google Gemini API key - dùng cho OCR đối chiếu ảnh + dịch thuật chính
# Tạo tại: https://aistudio.google.com/app/apikey
# Dùng Standard API key hoặc Authorization API key, KHÔNG dùng OAuth token/Client ID.
GEMINI_API_KEY=your_gemini_api_key_here

# OpenAI API key - fallback dịch thuật, không bắt buộc
OPENAI_API_KEY=your_openai_api_key_here

# Anthropic Claude API key - fallback dịch thuật, không bắt buộc
CLAUDE_API_KEY=your_claude_api_key_here

# Nếu không cấu hình provider hợp lệ, API sẽ trả lỗi cấu hình rõ ràng.

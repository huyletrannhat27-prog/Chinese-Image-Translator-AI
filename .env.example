# Anthropic Claude Vision OCR + dịch thuật
ANTHROPIC_API_KEY=your_anthropic_api_key_here
CLAUDE_MODEL=claude-haiku-4-5-20251001

# Tên cũ vẫn được hỗ trợ để tương thích, không bắt buộc
CLAUDE_API_KEY=

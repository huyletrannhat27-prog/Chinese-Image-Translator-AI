# Google Gemini API key - OCR + dịch thuật bằng Gemini Vision
GEMINI_API_KEY=your_gemini_api_key_here

# OpenAI Vision OCR + dịch thuật
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-5.6-terra

# Anthropic Claude Vision OCR + dịch thuật
ANTHROPIC_API_KEY=your_anthropic_api_key_here
CLAUDE_MODEL=claude-haiku-4-5-20251001

# Tên cũ vẫn được hỗ trợ để tương thích, không bắt buộc
CLAUDE_API_KEY=

# --- Phase 4: Rate limiting + Cache (tùy chọn) ---
# Không set 2 biến dưới đây -> app tự fallback về rate limit/cache trong bộ
# nhớ tiến trình (đủ dùng để dev/demo local, KHÔNG dùng khi deploy nhiều
# instance/serverless thật vì mỗi instance sẽ có bộ đếm riêng).
# Tạo free database tại https://console.upstash.com/ rồi dán URL + token vào đây
# để có rate limit/cache đúng chuẩn production (xem _docs/07_phase4_optimization_tools.md).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Số request dịch tối đa/phút cho mỗi IP (áp dụng chung cho cả 3 provider)
RATE_LIMIT_REQUESTS_PER_MINUTE=5

# TTL cache kết quả dịch, tính bằng giây (mặc định 1 giờ)
TRANSLATION_CACHE_TTL_SECONDS=3600

# Thời gian tối đa chờ 1 provider trả lời trước khi coi là timeout (ms)
PROVIDER_TIMEOUT_MS=45000

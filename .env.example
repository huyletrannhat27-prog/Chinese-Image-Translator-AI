# Google Gemini API key - dùng cho dịch thuật chính (/api/translate)
# Lấy tại: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# OpenAI API key - fallback dịch thuật (/api/translate/openai), không bắt buộc
OPENAI_API_KEY=your_openai_api_key_here

# Anthropic Claude API key - fallback dịch thuật (/api/translate/claude), không bắt buộc
CLAUDE_API_KEY=your_claude_api_key_here

# Nếu không set GEMINI_API_KEY, app vẫn chạy được nhưng /api/translate
# sẽ trả về bản dịch giả (mock) để test luồng OCR + UI.